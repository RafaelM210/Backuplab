    {
      "Name": "BackpackLab",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "BackpackLabEditor",
      "Type": "Editor",
      "LoadingPhase": "Default"
    }
  ],
